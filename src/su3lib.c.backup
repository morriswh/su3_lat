    // output as numpy array
    // printf("Index: (%d, %d, %d)\n", index[0], index[1], index[2]);
    // for now, just print the first two lines
    printf("[(%lf)+1j*(%lf),(%lf)+1j*(%lf),(%lf)+1j*(%lf)]\n",
           link[0], link[1], link[2], link[3],
           link[4], link[5]);
    printf("[(%lf)+1j*(%lf),(%lf)+1j*(%lf),(%lf)+1j*(%lf)]\n",
           link[6], link[7],
           link[8], link[9], link[10], link[11]);
}

void trace(double *result, double *matrix) {
    result[0] = matrix[0] + matrix[8] + matrix[0]*matrix[8]
        - matrix[1]*matrix[9] - matrix[2]*matrix[6] + matrix[3]*matrix[7];
    result[1] = matrix[1] + matrix[9] - matrix[0]*matrix[9]
        - matrix[1]*matrix[8] + matrix[2]*matrix[7] + matrix[3]*matrix[6];
}

void plaquette(double *plaq, double *U, int spos, int mu, int nu) {
    // spos is in LVOLUME now
    int offs_br, offs_tl;

    if (mu == 0) {
        offs_br = 1;
    }
    else if (mu == 1) {
        offs_br = L;
    }
    else if (mu == 2) {
        offs_br = LSQUARE;
    }
    else {
        offs_br = LCUBE;
    }

    if (nu == 0) {
        offs_tl = 1;
    }
    else if (nu == 1) {
        offs_tl = L;
    }
    else if (nu == 2) {
        offs_tl = LSQUARE;
    }
    else {
        offs_tl = LCUBE;
    }

    int pos = D*spos + mu;
    double temp[X];
    get_link(plaq, U, mod(pos, LLENGTH));
    // matmul(plaq,plaq,temp);

    pos = D*(spos+offs_br) + nu;
    get_link(temp, U, mod(pos, LLENGTH));
    matmul(plaq,plaq,temp);

    pos = D*(spos+offs_tl) + mu;
    get_link(temp, U, mod(pos, LLENGTH));
    adjoint(temp, temp);
    matmul(plaq,plaq,temp);

    pos = D*spos + nu;
    get_link(temp, U, mod(pos, LLENGTH));
    adjoint(temp,temp);
    matmul(plaq,plaq,temp);
}

void transform(double *Up, double *U, double *Om) {
    int pos;
    int opos;
    int offs;
    double link[X];
    double omegaL[X];
    double omegaR[X];
    for (int i = 0; i < LLENGTH; i++) {
        pos = X*i;
        opos = X*(i/D);
        offs = X*ipow(L,i%D); 
        
        // if (h == 0) {
        //     offs = X;
        // }
        // else if (h == 1) {
        //     offs = X*L;
        // }
        // else if (h ==2) {
        //     offs = X*LSQUARE;
        // }
        // else {
        //     offs = X*LCUBE;
        // }

        for (int j = 0; j < X; j++) {
            link[j] = U[pos+j];
            omegaL[j] = Om[opos+j];
            omegaR[j] = Om[mod(opos+offs+j, OLENGTH)];
        }
        adjoint(omegaR,omegaR);

        matmul(link,omegaL,link);
        matmul(link,link,omegaR);

        for (int k = 0; k < X; k++) {
            Up[pos+k] = link[k];
        }
    }
}

void gauge_action(double *action, double *U) {
    double plaq[X];
    double sum = 0;
    double tr[2];
    int i = 0, j = 0, k = 0;
    // I don't understand 'reduction' yet, but apparently it is needed
    #pragma omp parallel for reduction(+:sum) private(tr, plaq, j, k)
    for (i = 0; i < LVOLUME; i++) {
        for (j = 0; j < D; j++) {
            for (k = j+1; k < D; k++) {
                plaquette(plaq, U, i, j, k);
                trace(tr, plaq);
                sum += tr[0];
            }
        }
    }
    *action = 2*beta*(3*T*L - sum);
}

void read_nersc(double *U) {
    // need to figure out the issue with fread and doubles for the NERSC config
    // for now the union method works I guess
    union {
        long int retriever[CLENGTH];
        double U[CLENGTH];
    } package; 
    FILE *config = fopen("thyp2.1_gauge_nohead", "rb");
    // const size_t ret_code = 
    fread(package.retriever, sizeof(package.retriever[0]), CLENGTH, config);
    for (int i = 0; i != CLENGTH; i++) {
        package.retriever[i] = be64toh(package.retriever[i]);
        U[i] = package.U[i];
    }
}


