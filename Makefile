CC        := gcc
AR				:= gcc-ar
SRC_DIR   := src
BUILD_DIR := build

CPPFLAGS  := -I$(SRC_DIR)
DEPFLAGS  := -MMD -MP
CFLAGS    := -Wall -Wextra -fopenmp -O3 -flto -march=native -ffp-contract=off
LDFLAGS   := -L$(BUILD_DIR) -fopenmp -flto
# Order matters for static libs: dependents first, dependencies last
LDLIBS    := -lfileIO -lapelib -lsu3lib -lmatops -llapack -lm

LIBS      := fileIO matops su3lib apelib
LIBFILES  := $(LIBS:%=$(BUILD_DIR)/lib%.a)

# Override on the command line, e.g.  make file=source_avg_num
file      ?= imProp
TARGET    := $(file)32

.PHONY: all clean
.PRECIOUS: $(BUILD_DIR)/%.o

all: $(TARGET)

$(TARGET): $(SRC_DIR)/$(file).c $(LIBFILES)
	$(CC) $(CPPFLAGS) $(CFLAGS) -g $< $(LDFLAGS) $(LDLIBS) -o $@

$(BUILD_DIR)/lib%.a: $(BUILD_DIR)/%.o
	$(AR) rcs $@ $<

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CPPFLAGS) $(DEPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $@

clean:
	$(RM) -r $(BUILD_DIR)

# Track header changes automatically (generated by -MMD)
-include $(wildcard $(BUILD_DIR)/*.d)
